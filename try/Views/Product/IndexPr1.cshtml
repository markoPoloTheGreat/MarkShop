@model IEnumerable<MarkShop.Models.Product>

@{//ewfere
    ViewData["Title"] = "The Writing Gallery";
}

<!-- Bootstrap Icons -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

<div class="container py-5">
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-end mb-5 border-bottom pb-4">
        <div>
            <h1 class="display-5 fw-bold text-dark mb-1">The Writing Gallery</h1>
            <p class="lead text-muted mb-md-0">Premium instruments for the discerning writer.</p>
        </div>

        @if (User.IsInRole("Admin"))
        {
            <div class="mt-3 mt-md-0">
                <a asp-action="CreatePr" class="btn btn-primary btn-lg px-4 shadow-sm rounded-pill">
                    <i class="bi bi-plus-circle me-2"></i>Admin: New Arrival
                </a>
            </div>
        }
    </div>

    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 row-cols-xl-4 g-4">
        @foreach (var item in Model)
        {
            <div class="col">
                <div class="card h-100 shadow-sm border-0 product-card">
                    <!-- Image Section -->
                    <div class="position-relative overflow-hidden rounded-top" style="height: 200px; background-color: #fcfcfc;">
                        <img src="@(string.IsNullOrEmpty(item.ImageUrl) ? "https://images.unsplash.com/photo-1583485088034-7160b52ad572?q=80&w=500" : item.ImageUrl)"
                             class="card-img-top w-100 h-100"
                             style="object-fit: contain; padding: 15px;"
                             alt="@item.Name"
                             onerror="this.src='https://images.unsplash.com/photo-1569025690938-a00729c9e1f9?q=80&w=500'">

                        <div class="position-absolute top-0 end-0 m-2">
                            <span class="badge rounded-pill bg-accent shadow-sm px-3 py-2">
                                $@item.Price.ToString("N2")
                            </span>
                        </div>
                    </div>

                    <!-- Content Section -->
                    <div class="card-body p-4 d-flex flex-column">
                        <div class="mb-3">
                            <small class="text-primary fw-bold text-uppercase ls-1">@item.Brand</small>
                            <h5 class="fw-bold text-dark mt-1 mb-0">@item.Name</h5>
                        </div>

                        <p class="text-muted small mb-4 line-clamp-2" style="height: 3em; overflow: hidden;">
                            @item.Description
                        </p>

                        <!-- Specifications Grid -->
                        <div class="specs-box p-3 rounded-3 bg-light mb-4 mt-auto">
                            <div class="row g-2">
                                <div class="col-6">
                                    <div class="d-flex align-items-center">
                                        <i class="bi bi-pencil-fill text-muted me-2 small"></i>
                                        <span class="small fw-semibold">@item.NibSize</span>
                                    </div>
                                </div>
                                <div class="col-6">
                                    <div class="d-flex align-items-center">
                                        <i class="bi bi-palette-fill text-muted me-2 small"></i>
                                        <span class="small fw-semibold text-truncate">@item.Color</span>
                                    </div>
                                </div>
                                <div class="col-6">
                                    <div class="d-flex align-items-center">
                                        <i class="bi bi-layers-fill text-muted me-2 small"></i>
                                        <span class="small fw-semibold">@item.Type</span>
                                    </div>
                                </div>
                                <div class="col-6">
                                    <div class="d-flex align-items-center">
                                        <i class="bi bi-stars text-muted me-2 small"></i>
                                        <span class="small fw-semibold">@item.Style</span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Actions -->
                        <div class="d-flex gap-2">
                            @if (item.Supply != null && item.Supply.Quantity > 0)
                            {
                                <form asp-controller="ShoppingCarts" asp-action="AddToCart" method="post" class="flex-grow-1">
                                    <input type="hidden" name="productId" value="@item.Id" />
                                    <button type="submit" class="btn btn-dark w-100 shadow-sm rounded-3">
                                        <i class="bi bi-bag-plus me-2"></i>Add to Cart
                                    </button>
                                </form>
                            }
                            else
                            {
                                <button class="btn btn-secondary w-100 shadow-sm rounded-3 flex-grow-1" disabled>
                                    <i class="bi bi-x-circle me-2"></i>Out of Stock
                                </button>
                            }
                        </div>

                        @if (User.IsInRole("Admin"))
                        {
                            <div class="mt-3 pt-3 border-top d-flex justify-content-between align-items-center">
                                <span class="badge bg-secondary">Stock: @(item.Supply?.Quantity ?? 0)</span>

                                <div class="d-flex gap-2">
                                    <form asp-controller="Product" asp-action="QuickRestock" method="post" class="d-flex gap-1 m-0">
                                        <input type="hidden" name="productId" value="@item.Id" />
                                        <input type="number" name="quantityToAdd" style="width: 70px;" class="form-control form-control-sm" placeholder="+Qty" required min="1" />
                                        <button type="submit" class="btn btn-sm btn-success rounded-3" title="Add Stock">
                                            <i class="bi bi-plus-lg"></i>
                                        </button>
                                    </form>

                                    <a asp-action="EditPr" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary rounded-3" title="Edit Product">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                </div>
                            </div>
                        }
                        </div>
                    </div>
                </div>

        }
    </div>
</div>

<style>
    :root {
        --primary-dark: #2c3e50;
        --accent-blue: #3498db;
    }

    body {
        background-color: #f5f7f9;
        font-family: 'Inter', system-ui, -apple-system, sans-serif;
    }

    .product-card {
        transition: all 0.3s ease;
        border: 1px solid rgba(0,0,0,0.05) !important;
    }

        .product-card:hover {
            transform: translateY(-10px);
            box-shadow: 0 20px 40px rgba(0,0,0,0.08) !important;
        }

    .bg-accent {
        background-color: var(--accent-blue) !important;
        color: white;
    }

    .ls-1 {
        letter-spacing: 1px;
        font-size: 0.7rem;
    }

    .text-primary {
        color: var(--accent-blue) !important;
    }

    .specs-box {
        border: 1px solid rgba(0,0,0,0.03);
    }

    .btn-dark {
        background-color: var(--primary-dark);
        border: none;
    }

        .btn-dark:hover {
            background-color: #1a252f;
        }

    .line-clamp-2 {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
    }
</style>