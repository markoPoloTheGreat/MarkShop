@model IEnumerable<MarkShop.Models.ShoppingCart>

@{
    ViewData["Title"] = "Shopping Carts";
    // Cast the ViewBag data so we can use it for lookups
    var products = ViewBag.Products as Dictionary<int, MarkShop.Models.Product>;
}

<!-- Bootstrap Icons -->

<link rel="stylesheet" href="https://www.google.com/search?q=https://cdn.jsdelivr.net/npm/bootstrap-icons%401.11.1/font/bootstrap-icons.css">

<div class="container py-5">
    <div class="mb-5 border-bottom pb-3">
        <h1 class="display-5 fw-bold text-dark">
            <i class="bi bi-cart3 me-2 text-primary"></i>
            @(User.IsInRole("Admin") ? "Admin: All System Carts" : "Your Shopping Cart")
        </h1>
    </div>

    @if (Model == null || !Model.Any() || !Model.Any(m => m.Items != null && m.Items.Any()))
    {
        <div class="text-center py-5 bg-white rounded shadow-sm">
            <i class="bi bi-cart-x display-1 text-muted"></i>
            <h3 class="mt-3">Your cart is empty</h3>
            <p class="text-muted">Looks like you haven't added any pens to your collection yet.</p>
            <a href="/Product/IndexPr1" class="btn btn-primary px-4 rounded-pill mt-2">Start Shopping</a>
        </div>
    }
    else
    {
        @foreach (var cart in Model)
        {
            <div class="card shadow-sm border-0 mb-5 overflow-hidden">
                <div class="card-header bg-dark text-white p-3 d-flex justify-content-between align-items-center">
                    <span class="fw-bold">
                        <i class="bi bi-hash"></i> Cart Order #@cart.Id
                    </span>
                    @if (User.IsInRole("Admin"))
                    {
                        <span class="badge bg-info text-dark">Customer ID: @cart.CustomerId</span>
                    }
                </div>

                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light text-secondary small text-uppercase">
                                <tr>
                                    <th class="ps-4" style="width: 40%;">Product Details</th>
                                    <th>Price</th>
                                    <th>Quantity</th>
                                    <th>Subtotal</th>
                                    <th class="text-end pe-4">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @{
                                    double cartTotal = 0;
                                }
                                @foreach (var item in cart.Items)
                                {
                                    // Look up the product details from the dictionary passed from the controller
                                    var product = (products != null && products.ContainsKey(item.ProductId)) ? products[item.ProductId] : null;
                                    var lineTotal = product != null ? (product.Price * item.Quantity) : 0;
                                    cartTotal += lineTotal;

                                    <tr>
                                        <td class="ps-4">
                                            @if (product != null)
                                            {
                                                <div class="d-flex align-items-center">
                                                    <div class="bg-light rounded p-2 me-3" style="width: 60px; height: 60px;">
                                                        <img src="@product.ImageUrl" class="img-fluid h-100" style="object-fit: contain;"
                                                             onerror="this.src='https://images.unsplash.com/photo-1583485088034-7160b52ad572?q=20&w=100'">
                                                    </div>
                                                    <div>
                                                        <div class="fw-bold text-dark">@product.Name</div>
                                                        <small class="text-muted">@product.Brand</small>
                                                    </div>
                                                </div>
                                            }
                                            else
                                            {
                                                <span class="text-danger small">
                                                    <i class="bi bi-exclamation-triangle me-1"></i>
                                                    Product ID: @item.ProductId (Info Unavailable)
                                                </span>
                                            }
                                        </td>
                                        <td>$@(product?.Price.ToString("N2") ?? "0.00")</td>
                                        <td>
                                            <span class="badge rounded-pill bg-light text-dark border px-3">@item.Quantity</span>
                                        </td>
                                        <td class="fw-bold text-primary">$@lineTotal.ToString("N2")</td>
                                        <td class="text-end pe-4">
                                            <form asp-action="DeleteItem" asp-controller="ShoppingCarts" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="itemId" value="@item.Id" />
                                                <button type="submit" class="btn btn-link text-danger p-0" title="Remove Item">
                                                    <i class="bi bi-trash3 fs-5"></i>
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot class="table-light">
                                <tr>
                                    <td colspan="3" class="text-end fw-bold py-3">Cart Total:</td>
                                    <td colspan="2" class="ps-3 py-3">
                                        <h4 class="text-success fw-bold mb-0">$@cartTotal.ToString("N2")</h4>
                                    </td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>

                <div class="card-footer bg-white p-3 d-flex justify-content-between">
                    <form asp-action="ClearCart" asp-route-id="@cart.Id" method="post">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-outline-danger btn-sm rounded-pill px-3"
                                onclick="return confirm('Clear all items from this cart?')">
                            <i class="bi bi-x-circle me-1"></i>Clear Cart
                        </button>
                    </form>
                    <div>
                        <a href="/Product/IndexPr1" class="btn btn-outline-secondary btn-sm rounded-pill px-3 me-2">Back to Shop</a>
                        <button class="btn btn-success btn-sm rounded-pill px-4 fw-bold shadow-sm">Checkout</button>
                    </div>
                </div>
            </div>
        }
    }


</div>

<style>
    .card {
        transition: all 0.3s ease;
    }

    .table th {
        border-top: none;
    }

    .bg-light {
        border: 1px solid rgba(0,0,0,0.05);
    }

    .text-primary {
        color: #3498db !important;
    }

    .text-success {
        color: #27ae60 !important;
    }
</style>