@model MarkShop.Models.Product

@{
    ViewData["Title"] = "Your Perfect Match";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8 text-center">

            <div class="mb-4">
                <span class="badge bg-success rounded-pill px-3 py-2">MATCH FOUND</span>
            </div>

            <h1 class="display-4 fw-bold mb-3">@Model.Name</h1>
            <p class="text-muted fs-4">@Model.Brand</p>

            <div class="card shadow-lg border-0 rounded-3 overflow-hidden mt-4">
                <div class="row g-0">
                    <div class="col-md-6 bg-light d-flex align-items-center justify-content-center p-4">
                        @if (!string.IsNullOrEmpty(Model.ImageUrl))
                        {
                            <img src="@Model.ImageUrl" class="img-fluid" style="max-height: 300px; object-fit: contain;" alt="@Model.Name">
                        }
                        else
                        {
                            <div class="text-muted p-5 border rounded">No Image Available</div>
                        }
                    </div>
                    <div class="col-md-6 p-5 text-start d-flex flex-column justify-content-center">
                        <h3 class="mb-3">Why this pen?</h3>
                        <p class="text-secondary mb-4">
                            @Model.Description
                        </p>

                        <div class="d-flex justify-content-between align-items-center mb-4 border-top border-bottom py-3">
                            <div>
                                <small class="text-uppercase text-muted fw-bold" style="font-size: 0.7rem;">Color</small>
                                <div class="fw-bold">@Model.Color</div>
                            </div>
                            <div>
                                <small class="text-uppercase text-muted fw-bold" style="font-size: 0.7rem;">Nib</small>
                                <div class="fw-bold">@Model.NibSize</div>
                            </div>
                            <div>
                                <small class="text-uppercase text-muted fw-bold" style="font-size: 0.7rem;">Price</small>
                                <div class="fw-bold text-primary">$@Model.Price</div>
                            </div>
                        </div>

                        <!-- Action Buttons -->
                        <div class="d-grid gap-2">
                            @if (User.Identity.IsAuthenticated)
                            {
                                <!-- Add to Cart Form -->
                                <form asp-controller="ShoppingCarts" asp-action="AddToCart" method="post">
                                    <input type="hidden" name="productId" value="@Model.Id" />
                                    <button type="submit" class="btn btn-dark btn-lg w-100">
                                        Add to Cart
                                    </button>
                                </form>
                            }
                            else
                            {
                                <a asp-controller="Account" asp-action="Login" class="btn btn-outline-dark btn-lg">
                                    Log in to Buy
                                </a>
                            }

                            <a asp-controller="Quiz" asp-action="Index" class="btn btn-link text-muted mt-2">
                                Retake Quiz
                            </a>
                        </div>

                    </div>
                </div>
            </div>

            <div class="mt-5 text-muted small">
                <p>Based on Mahalanobis Distance calculation against our database of @Model.Brand pens.</p>
            </div>

        </div>
    </div>
</div>